{
  "name": "@keyhole-koro/paper-in-paper",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "React library for hierarchical paper tree visualization with drag-and-drop",
  "license": "MIT",
  "author": "Keyhole-Koro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Keyhole-Koro/paper-in-paper.git"
  },
  "homepage": "https://github.com/Keyhole-Koro/paper-in-paper#readme",
  "bugs": {
    "url": "https://github.com/Keyhole-Koro/paper-in-paper/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.lib.json && node scripts/fix-dts-extensions.mjs dist/types && vite build",
    "build:demo": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^3.2.4"
  }
}
